<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SpellforceDataEditor.Avalonia.MainWindow"
        Title="SpellforceDataEditor.Avalonia">
    <DockPanel>
        <Button DockPanel.Dock="Top" Content="GameData Editor" Name="GameDataEditorButton"/>
        <Button DockPanel.Dock="Top" Content="Load CFF File" Name="LoadCffFileButton"/>
    </DockPanel>
</Window>
